# Optional. Public base URL used for canonical links, sitemap and Open Graph.
# Leave unset on Vercel: the production *.vercel.app domain is detected automatically.
# Set it once a custom domain is attached, e.g. https://ahmedkhanpatan.dev
NEXT_PUBLIC_SITE_URL=

# --- Ask Ahmed AI (optional) ------------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit a real key.
# Create a key at https://console.groq.com/keys
# Without it the site works normally and the assistant shows an "unavailable" notice.
GROQ_API_KEY=

# Optional. Any chat model ID from https://console.groq.com/docs/models
# Defaults to openai/gpt-oss-120b when empty.
GROQ_MODEL=

# --- Supabase (V2.2: contact form + Ask Ahmed AI quotas) ---------------------
# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit real values.
# Project URL: Supabase dashboard -> Project Settings -> Data API (or the Connect dialog).
SUPABASE_URL=
# Secret key (sb_secret_...): Project Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=

# Abuse-protection limits (per UTC day). Defaults shown.
AI_DAILY_SESSION_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=40
CONTACT_DAILY_SESSION_LIMIT=3

# Development only: lets Ask Ahmed AI run without Supabase on `npm run dev`.
# Ignored by `next build`, `next start` and Vercel (NODE_ENV=production).
AI_QUOTA_DEV_BYPASS=false
